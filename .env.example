# Copy this file to .env to use a real AI model.
# Leave LLM_PROVIDER=mock to run with no API key — every screen and safety scenario still works.
LLM_PROVIDER=mock

# --- Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-5-5

# --- Any OpenAI-compatible API (OpenAI, Gemini, Groq, Ollama…) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
#   Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1   (pick a vision-capable model for reading bills)
# LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT=25
PORT=8000
GUARDIAN_NAME=Ravi (son)
